# Copy to .env and fill in. Never commit real values.
# The browser never calls the Go API directly: this app's route handlers (BFF) forward requests and keep the
# session in httpOnly cookies. Development falls back to the localhost values below when unset.

# Go API as reachable from this server (can be an internal address). Required in production.
BACKEND_URL=http://localhost:4000

# Go API as reachable from browsers (Google sign-in redirects there). Defaults to BACKEND_URL.
BACKEND_PUBLIC_URL=http://localhost:4000

# This app's public origin (https in production): cookies, same-origin checks, metadata, sitemap.
# Production: https://sakdulur.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Same value as the API's BFF_SHARED_SECRET (32+ random characters). Lets the API trust the visitor IP this
# server forwards, so rate limits work per visitor. Optional in development.
BFF_SHARED_SECRET=

# Optional: shown in the footer and the Privacy Policy / Terms (src/lib/legal-content.ts).
# Defaults: Fahmi Alfareza / fahmialfareza97@gmail.com.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_OPERATOR_NAME=

# Optional: extra image hosts for the Content-Security-Policy (comma-separated origins). Cloudinary is built in.
NEXT_PUBLIC_IMAGE_HOSTS=

# Optional: search console verification (the content value of their meta tags).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional: Sentry error, performance and replay reports. Without a DSN nothing is sent.
# NEXT_PUBLIC_SENTRY_DSN is build-time (browser); SENTRY_DSN is the same value as a runtime variable of the Worker.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Build-time, to upload source maps (the deploy workflow: SENTRY_AUTH_TOKEN as a repository secret).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional: mobile apps (apps/native). Serve /.well-known files so email links open in the app.
# IOS_APP_IDS: "<Apple Team ID>.com.fahmialfareza.sakdulur" (comma-separated if several).
# ANDROID_CERT_SHA256: SHA-256 signing certificate fingerprints from Play Console > App integrity.
IOS_APP_IDS=
ANDROID_APP_PACKAGE=com.fahmialfareza.sakdulur
ANDROID_CERT_SHA256=
