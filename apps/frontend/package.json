{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "build:pages": "next build && pnpm --filter native build:web && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-pages.mjs",
    "preview:pages": "pnpm build:pages && cd ../.. && apps/frontend/node_modules/.bin/wrangler pages dev apps/frontend/.pages --compatibility-date 2026-05-01",
    "deploy:pages": "pnpm build:pages && cd ../.. && apps/frontend/node_modules/.bin/wrangler pages deploy apps/frontend/.pages --project-name sakdulur --no-bundle"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-slot": "^1.5.0",
    "@sentry/nextjs": "^11.10.0",
    "@tanstack/react-query": "^5.106.1",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "elkjs": "^0.12.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.577.0",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  },
  "volta": {
    "node": "24.11.0",
    "pnpm": "10.20.0"
  }
}
