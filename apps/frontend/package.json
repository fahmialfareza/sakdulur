{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "build:pages": "opennextjs-cloudflare build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-pages.mjs",
    "preview:pages": "pnpm build:pages && cd ../.. && apps/frontend/node_modules/.bin/wrangler pages dev apps/frontend/.pages --compatibility-date 2026-01-08 --compatibility-flags nodejs_compat",
    "deploy:pages": "pnpm build:pages && cd ../.. && apps/frontend/node_modules/.bin/wrangler pages deploy apps/frontend/.pages --project-name sakdulur --no-bundle",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@opennextjs/cloudflare": "^1.19.4",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^11.10.0",
    "@tanstack/react-query": "^5.104.5",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "elkjs": "^0.12.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.555.0",
    "next": "16.0.10",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.74.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.0.6",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.85.0"
  },
  "volta": {
    "node": "24.11.0",
    "pnpm": "10.20.0"
  }
}
