{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "sakdulur",
  "compatibility_date": "2026-01-08",
  "compatibility_flags": ["nodejs_compat"],
  // keep_names makes esbuild add __name() calls, which break scripts that are inlined via Function#toString
  // (next-themes' no-flash theme script threw "__name is not defined").
  "keep_names": false,
  // The site runs on Cloudflare Pages: scripts/build-pages.mjs bundles the Worker with this file
  // (`wrangler deploy --dry-run`) into the Pages `_worker.js`. Runtime variables live in the Pages project
  // (Settings > Variables and Secrets). The `sakdulur` Worker this file used to deploy is kept for a while as the rollback;
  // keep_vars stops a `wrangler deploy` from deleting its dashboard vars. See docs/production-setup.md.
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
