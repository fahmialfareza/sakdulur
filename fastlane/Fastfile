# Store listings for App Store Connect (iPhone, iPad, Mac) and Google Play, in Indonesian and English.
# Text: fastlane/metadata/{apple,android}/<locale>/*.txt. Screenshots: fastlane/screenshots/{ios,mac}/<locale>
# and fastlane/metadata/android/<locale>/images. Store builds are uploaded by the GitHub release workflows
# (apps/native/RELEASE.md); these lanes never upload a binary. Only apple_submit submits for review.
#
#   fastlane apple version:1.1.4            # iPhone/iPad and Mac: text, screenshots, category, age rating, review info
#   fastlane apple version:1.1.4 platform:ios what:text   # platform ios|mac|both, what text|screenshots|both
#   fastlane apple_submit build:114         # What's New (the Play notes for that build), attach the build, submit
#   fastlane apple_submit build:114 platform:ios submit:false   # everything but the submission
#   fastlane apple_pricing                  # make the app free (once)
#   fastlane play                           # Google Play: listing text, graphics, screenshots, contact details
#   fastlane play what:text                 # what text|screenshots|notes|both (both = text + screenshots)
#   fastlane play what:notes track:alpha    # release notes (metadata/android/<locale>/changelogs) on the newest
#                                           # build of a track (default internal)
#
# Needs (shell profile, not the repo):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH   App Store Connect API key
#   PLAY_JSON_KEY                             Google Play service account JSON (~/.config/play/sakdulur-play.json)
#   SAKDULUR_DEMO_ACCOUNT                     file with the review demo account ("email: …" / "password: …")

require "fileutils"
require "json"
require "net/http"
require "openssl"
require "tmpdir"

# Homebrew's Ruby may lack a default CA file ("certificate verify failed"); use Homebrew's bundle (as Dzikir App).
HOMEBREW_CA = "/opt/homebrew/etc/ca-certificates/cert.pem"
if ENV["SSL_CERT_FILE"].to_s.empty? && !File.exist?(OpenSSL::X509::DEFAULT_CERT_FILE) && File.exist?(HOMEBREW_CA)
  ENV["SSL_CERT_FILE"] = HOMEBREW_CA
  OpenSSL::SSL::SSLContext::DEFAULT_CERT_STORE.add_file(HOMEBREW_CA)
end

ROOT = File.expand_path("..", __dir__)
FL = File.join(ROOT, "fastlane")
SUPPORT_EMAIL = "fahmialfareza97@gmail.com"
WEBSITE = "https://sakdulur.com"

def env!(name)
  value = ENV[name].to_s
  UI.user_error!("Set #{name} (see the top of fastlane/Fastfile)") if value.empty?
  value
end

# The App Store version of a build, as scripts/release-native.mjs derives it (114 = 1.1.4), or version:1.2.3.
def app_version(options)
  version = options[:version].to_s
  return version unless version.empty?
  build = options[:build].to_s
  UI.user_error!("Pass version:1.2.3 (or build:123)") unless build.match?(/\A[1-9]\d*\z/)
  n = build.to_i
  "#{n / 100}.#{(n % 100) / 10}.#{n % 10}"
end

# What's New for a build: the same text as its Play release notes (metadata/android/<locale>/changelogs/<build>.txt,
# else default.txt), in a folder deliver reads as metadata (only release_notes.txt, so nothing else changes).
def release_notes_metadata(build)
  dir = Dir.mktmpdir("sakdulur-release-notes")
  { "en-US" => "en-US", "id" => "id" }.each do |play, apple|
    changelogs = File.join(FL, "metadata", "android", play, "changelogs")
    file = [File.join(changelogs, "#{build}.txt"), File.join(changelogs, "default.txt")].find { |f| File.exist?(f) }
    UI.user_error!("No release notes for #{play}: write #{changelogs}/#{build}.txt") unless file
    FileUtils.mkdir_p(File.join(dir, apple))
    File.write(File.join(dir, apple, "release_notes.txt"), File.read(file).strip)
  end
  dir
end

def asc_api_key
  app_store_connect_api_key(
    key_id: env!("ASC_KEY_ID"),
    issuer_id: env!("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(env!("ASC_KEY_PATH")),
    in_house: false
  )
end

def demo_account
  text = File.read(File.expand_path(env!("SAKDULUR_DEMO_ACCOUNT")))
  email = text[/^email:\s*(\S+)/, 1]
  password = text[/^password:\s*(\S+)/, 1]
  UI.user_error!("SAKDULUR_DEMO_ACCOUNT needs 'email:' and 'password:' lines") unless email && password
  [email, password]
end

lane :apple do |options|
  platforms = { "ios" => ["ios"], "mac" => ["osx"], "both" => %w[ios osx] }[options[:platform] || "both"]
  UI.user_error!("platform must be ios, mac or both") unless platforms
  what = options[:what] || "both"
  UI.user_error!("what must be text, screenshots or both") unless %w[text screenshots both].include?(what)
  version = app_version(options)
  api_key = asc_api_key
  email, password = demo_account

  # Indonesian is the primary language (shown where the user's language isn't listed).
  app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
  app.update(attributes: { primaryLocale: "id" }) unless app.primary_locale == "id"

  platforms.each do |platform|
    screenshots = File.join(FL, "screenshots", platform == "osx" ? "mac" : "ios")
    UI.header("#{platform == 'osx' ? 'macOS' : 'iOS'} #{version}: #{what}")
    deliver(
      api_key: api_key,
      platform: platform,
      app_version: version,
      metadata_path: File.join(FL, "metadata", "apple"),
      screenshots_path: screenshots,
      skip_metadata: what == "screenshots",
      skip_screenshots: what == "text" || !Dir.exist?(screenshots),
      overwrite_screenshots: true,
      app_rating_config_path: File.join(FL, "app-rating.json"),
      app_review_information: {
        first_name: "Fahmi",
        last_name: "Alfareza",
        phone_number: "+6285117319725",
        email_address: SUPPORT_EMAIL,
        demo_user: email,
        demo_password: password,
        notes: File.read(File.join(FL, "review-notes.txt")).strip
      },
      skip_binary_upload: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true
    )
  end
end

# Sets the version's What's New (the Play notes for the build), attaches the processed build and submits it for App
# Review; the rest of the listing is unchanged. The version (114 = 1.1.4) is created when App Store Connect has none.
#   fastlane apple_submit build:114 platform:ios|mac|both submit:true|false
lane :apple_submit do |options|
  build = options[:build].to_s
  UI.user_error!("Pass the build number, e.g. build:114") if build.empty?
  version = app_version(options)
  platforms = { "ios" => ["ios"], "mac" => ["osx"], "both" => %w[ios osx] }[options[:platform] || "both"]
  UI.user_error!("platform must be ios, mac or both") unless platforms
  submit = options[:submit].to_s != "false"
  notes = release_notes_metadata(build)
  api_key = asc_api_key
  platforms.each do |platform|
    UI.header("#{platform == 'osx' ? 'macOS' : 'iOS'} #{version} (#{build}): What's New#{submit ? ', submit for review' : ''}")
    deliver(
      api_key: api_key,
      platform: platform,
      app_version: version,
      build_number: build,
      metadata_path: notes,
      screenshots_path: File.join(FL, "screenshots", platform == "osx" ? "mac" : "ios"),
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: submit,
      automatic_release: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        content_rights_contains_third_party_content: false,
        export_compliance_uses_encryption: false
      },
      run_precheck_before_submit: false,
      force: true
    )
  end
end

# Apple: "Free" (price point 0 in the base territory, USA, applied everywhere). deliver's price_tier uses an API
# Apple has removed, so this calls App Store Connect directly.
lane :apple_pricing do
  token = Spaceship::ConnectAPI::Token.create(
    key_id: env!("ASC_KEY_ID"), issuer_id: env!("ASC_ISSUER_ID"), filepath: File.expand_path(env!("ASC_KEY_PATH"))
  )
  Spaceship::ConnectAPI.token = token
  app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
  http = Net::HTTP.new("api.appstoreconnect.apple.com", 443).tap { |h| h.use_ssl = true }
  headers = { "Authorization" => "Bearer #{token.text}", "Content-Type" => "application/json" }

  points = JSON.parse(http.get("/v1/apps/#{app.id}/appPricePoints?filter[territory]=USA&limit=200", headers).body)
  free = (points["data"] || []).find { |p| p.dig("attributes", "customerPrice").to_f.zero? }
  UI.user_error!("No free price point found") unless free

  body = {
    data: {
      type: "appPriceSchedules",
      relationships: {
        app: { data: { type: "apps", id: app.id } },
        baseTerritory: { data: { type: "territories", id: "USA" } },
        manualPrices: { data: [{ type: "appPrices", id: "${price}" }] }
      }
    },
    included: [{
      type: "appPrices", id: "${price}",
      attributes: { startDate: nil },
      relationships: { appPricePoint: { data: { type: "appPricePoints", id: free["id"] } } }
    }]
  }
  res = http.post("/v1/appPriceSchedules", body.to_json, headers)
  UI.user_error!("Pricing failed: #{res.code} #{res.body}") unless res.code.start_with?("2")
  UI.success("Sakdulur is free on the App Store")

  # Availability: every territory, and new ones as Apple adds them (only set when the app has none yet).
  if http.get("/v1/apps/#{app.id}/appAvailabilityV2", headers).code == "404"
    territories = JSON.parse(http.get("/v1/territories?limit=200", headers).body)["data"].map { |t| t["id"] }
    refs = territories.map { |t| { type: "territoryAvailabilities", id: "${#{t}}" } }
    body = {
      data: {
        type: "appAvailabilities",
        attributes: { availableInNewTerritories: true },
        relationships: { app: { data: { type: "apps", id: app.id } }, territoryAvailabilities: { data: refs } }
      },
      included: territories.map do |t|
        {
          type: "territoryAvailabilities", id: "${#{t}}", attributes: { available: true },
          relationships: { territory: { data: { type: "territories", id: t } } }
        }
      end
    }
    res = http.post("/v2/appAvailabilities", body.to_json, headers)
    UI.user_error!("Availability failed: #{res.code} #{res.body}") unless res.code.start_with?("2")
    UI.success("Sakdulur is available in #{territories.size} countries and regions")
  end
end

def play_api(json_key)
  require "googleauth"
  creds = Google::Auth::ServiceAccountCredentials.make_creds(
    json_key_io: File.open(json_key), scope: "https://www.googleapis.com/auth/androidpublisher"
  )
  headers = { "Authorization" => "Bearer #{creds.fetch_access_token!['access_token']}", "Content-Type" => "application/json" }
  Net::HTTP.start("androidpublisher.googleapis.com", 443, use_ssl: true) { |http| yield http, headers }
end

# supply always looks up a release, even for listing-only updates; use the track's newest build.
def play_version_code(json_key, package_name, track_name)
  base = "/androidpublisher/v3/applications/#{package_name}/edits"
  play_api(json_key) do |http, headers|
    edit = JSON.parse(http.post(base, "{}", headers).body)
    UI.user_error!("Google Play: #{edit.dig('error', 'message')}") unless edit["id"]
    track = JSON.parse(http.get("#{base}/#{edit['id']}/tracks/#{track_name}", headers).body)
    http.request(Net::HTTP::Delete.new("#{base}/#{edit['id']}", headers))
    codes = (track["releases"] || []).flat_map { |r| r["versionCodes"] || [] }.map(&:to_i)
    UI.user_error!("No build on the #{track_name} track yet") if codes.empty?
    codes.max
  end
end

# Google Play's default language and contact details (not covered by supply). Category and the App content forms aren't in Google's
# API; see apps/native/store/google-play.md.
def play_contact_details(json_key, package_name)
  base = "/androidpublisher/v3/applications/#{package_name}/edits"
  play_api(json_key) do |http, headers|
    edit = JSON.parse(http.post(base, "{}", headers).body)
    UI.user_error!("Google Play: #{edit.dig('error', 'message')}") unless edit["id"]
    details = { defaultLanguage: "id", contactEmail: SUPPORT_EMAIL, contactWebsite: WEBSITE }
    res = http.request(Net::HTTP::Patch.new("#{base}/#{edit['id']}/details", headers).tap { |r| r.body = details.to_json })
    UI.user_error!("Google Play details: #{res.body}") unless res.code.start_with?("2")
    res = http.post("#{base}/#{edit['id']}:commit", "", headers)
    UI.user_error!("Google Play commit: #{res.body}") unless res.code.start_with?("2")
  end
  UI.success("Google Play: default language Indonesian; contact #{SUPPORT_EMAIL}, #{WEBSITE}")
end

lane :play do |options|
  what = options[:what] || "both"
  UI.user_error!("what must be text, screenshots, notes or both") unless %w[text screenshots notes both].include?(what)
  track = options[:track] || "internal"
  json_key = File.expand_path(env!("PLAY_JSON_KEY"))
  package_name = CredentialsManager::AppfileConfig.try_fetch_value(:package_name)

  supply(
    package_name: package_name,
    json_key: json_key,
    metadata_path: File.join(FL, "metadata", "android"),
    track: track,
    version_code: play_version_code(json_key, package_name, track),
    skip_upload_apk: true,
    skip_upload_aab: true,
    skip_upload_changelogs: what != "notes",
    skip_upload_metadata: %w[screenshots notes].include?(what),
    skip_upload_images: %w[text notes].include?(what),
    skip_upload_screenshots: %w[text notes].include?(what),
    sync_image_upload: true
  )
  play_contact_details(json_key, package_name) if %w[text both].include?(what)
end

# What each Google Play track holds (read-only).
lane :play_tracks do
  json_key = File.expand_path(env!("PLAY_JSON_KEY"))
  base = "/androidpublisher/v3/applications/#{CredentialsManager::AppfileConfig.try_fetch_value(:package_name)}/edits"
  play_api(json_key) do |http, headers|
    edit = JSON.parse(http.post(base, "{}", headers).body)
    UI.user_error!("Google Play: #{edit.dig('error', 'message')}") unless edit["id"]
    tracks = JSON.parse(http.get("#{base}/#{edit['id']}/tracks", headers).body)["tracks"] || []
    http.request(Net::HTTP::Delete.new("#{base}/#{edit['id']}", headers))
    tracks.each do |t|
      (t["releases"] || []).each { |r| UI.message("#{t['track']}: #{r['name']} #{r['versionCodes']&.join(',')} #{r['status']}") }
    end
  end
end

# Gives a build already on one track (internal) to another (alpha = closed testing), with its release notes.
#   fastlane play_promote build:102 [from:internal] [to:alpha]
lane :play_promote do |options|
  build = options[:build].to_s
  UI.user_error!("build: is required") if build.empty?
  from = options[:from] || "internal"
  to = options[:to] || "alpha"
  json_key = File.expand_path(env!("PLAY_JSON_KEY"))
  base = "/androidpublisher/v3/applications/#{CredentialsManager::AppfileConfig.try_fetch_value(:package_name)}/edits"
  play_api(json_key) do |http, headers|
    edit = JSON.parse(http.post(base, "{}", headers).body)
    UI.user_error!("Google Play: #{edit.dig('error', 'message')}") unless edit["id"]
    source = JSON.parse(http.get("#{base}/#{edit['id']}/tracks/#{from}", headers).body)
    release = (source["releases"] || []).find { |r| (r["versionCodes"] || []).include?(build) }
    UI.user_error!("Build #{build} is not on the #{from} track") unless release
    body = { track: to, releases: [release.slice("name", "versionCodes", "releaseNotes").merge("status" => "completed")] }
    res = http.put("#{base}/#{edit['id']}/tracks/#{to}", body.to_json, headers)
    UI.user_error!("Google Play #{to}: #{res.body}") unless res.code.start_with?("2")
    res = http.post("#{base}/#{edit['id']}:commit", "", headers)
    UI.user_error!("Google Play commit: #{res.body}") unless res.code.start_with?("2")
  end
  UI.success("Google Play: build #{build} sent from #{from} to #{to}")
end
